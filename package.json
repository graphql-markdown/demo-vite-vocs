{
  "name": "demo-vite-vocs",
  "private": true,
  "version": "1.35.0",
  "type": "module",
  "scripts": {
    "dev": "vocs dev",
    "build": "vocs build && node -e \"require('node:fs').cpSync('.markdown-copies','dist/public',{recursive:true})\"",
    "preview": "vocs preview",
    "doc": "gqlmd graphql-to-doc && gqlmd graphql-to-doc:markdown",
    "gqlmd": "gqlmd",
    "test:visual": "playwright test"
  },
  "dependencies": {
    "@emotion/react": "latest",
    "@emotion/styled": "latest",
    "@graphql-markdown/cli": "^1.3.0",
    "@graphql-markdown/formatters": "^1.3.0",
    "@graphql-markdown/graphql": "^1.4.0",
    "@graphql-markdown/printer-legacy": "^1.21.0",
    "react": "latest",
    "react-dom": "latest",
    "vocs": "^2.14.1",
    "waku": "1.0.0-rc.5"
  },
  "devDependencies": {
    "@argos-ci/playwright": "^7.10.0",
    "@playwright/test": "^1.65.1",
    "@types/react": "latest",
    "serve": "^14.2.8",
    "typescript": "latest"
  }
}
